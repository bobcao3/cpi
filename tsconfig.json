{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "extensions/**/*.ts",
    "scripts/harness/**/*.ts",
    "scripts/shell/**/*.ts"
  ]
}
