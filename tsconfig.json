{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "bun"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/cli/src/**/*.ts",
    "packages/cli/bootstrap.d.mts",
    "packages/harness/src/**/*.ts",
    "packages/harness/scripts/harness/**/*.ts",
    "packages/harness/scripts/shell/**/*.ts"
  ]
}
