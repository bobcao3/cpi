{
  "name": "cpi",
  "version": "0.1.1",
  "license": "MIT",
  "description": "The cpi CLI, extensions, skills, and supporting tools for the Pi fork.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "prepare:fork": "node scripts/fork.mjs",
    "install:dev": "bun install --frozen-lockfile --ignore-scripts && node scripts/fork.mjs && bun link --ignore-scripts --cwd packages/cli",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "ghostmux:build": "cd packages/ghostmux && zig build --release=safe",
    "ghostmux:test-install": "node packages/ghostmux/install.test.mjs",
    "test:cli": "cd packages/cli && node ../../node_modules/vitest/dist/cli.js --run test/vcs.test.ts test/footer-project.test.ts",
    "pack:release": "node packages/cli/scripts/package.mjs",
    "verify:release": "node packages/cli/scripts/verify-installed.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "jiti": "2.7.0",
    "mustache": "4.2.0",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "@bobcao3/cpi-tree-sitter-wasm": "0.0.1",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/7c3947a36845e9eb9a1fa6d48421c6ba492245953c8d387350fba9751cfea2b4.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/1cf2cd293b39c3f92349b607f49abf9c28ae1c6edd649941d24958027a5f536a.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/b8a12eb1579610030f80c9b04f7094944ffb91cc7f45036d7548622876506239.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/6fb828da22ed7384d8473f3fdcce311acc5228ba0c1a8c25a5e9aca2247fab7f.tgz",
    "@earendil-works/pi-durable": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/51716003100412e14db6142bf87f872821229e4c73da1defa0c12810668bdd14.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/f15e517520cfb7b55a9b498badaa03fac05d0cf08870078caaf9c3c574cfce65.tgz"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/7c3947a36845e9eb9a1fa6d48421c6ba492245953c8d387350fba9751cfea2b4.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/1cf2cd293b39c3f92349b607f49abf9c28ae1c6edd649941d24958027a5f536a.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/b8a12eb1579610030f80c9b04f7094944ffb91cc7f45036d7548622876506239.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/6fb828da22ed7384d8473f3fdcce311acc5228ba0c1a8c25a5e9aca2247fab7f.tgz",
    "@earendil-works/pi-durable": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/51716003100412e14db6142bf87f872821229e4c73da1defa0c12810668bdd14.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-2/f15e517520cfb7b55a9b498badaa03fac05d0cf08870078caaf9c3c574cfce65.tgz"
  },
  "devDependencies": {
    "@cpi/cli": "0.0.4",
    "@cpi/harness": "0.0.4",
    "@cpi/ghostmux": "0.0.4",
    "@cpi/tree-sitter-wasm": "0.0.4",
    "@types/bun": "1.4.2",
    "@types/mustache": "4.2.6",
    "@types/node": "22.19.19",
    "diff": "8.0.4",
    "es-module-lexer": "2.3.1",
    "esbuild": "0.28.2",
    "prettier": "3.8.4",
    "tar": "7.5.22",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/harness",
    "packages/ghostmux",
    "packages/tree-sitter-wasm"
  ],
  "bin": {
    "cpi": "packages/cli/bin/cpi"
  },
  "files": [
    "packages/cli",
    "packages/harness",
    "packages/ghostmux",
    "packages/tree-sitter-wasm",
    "!**/node_modules",
    "!**/.zig-cache",
    "!**/zig-out",
    "!**/zig-pkg",
    "!**/.cache",
    "!**/dist",
    "!**/assets",
    "!**/native.json",
    "!**/*.tgz",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@cpi/ghostmux-linux-x64": "npm:@bobcao3/cpi-ghostmux-linux-x64@0.0.1",
    "@cpi/ghostmux-linux-arm64": "npm:@bobcao3/cpi-ghostmux-linux-arm64@0.0.1",
    "@cpi/ghostmux-darwin-x64": "npm:@bobcao3/cpi-ghostmux-darwin-x64@0.0.1",
    "@cpi/ghostmux-darwin-arm64": "npm:@bobcao3/cpi-ghostmux-darwin-arm64@0.0.1",
    "@cpi/ghostmux-win32-x64": "npm:@bobcao3/cpi-ghostmux-win32-x64@0.0.1"
  }
}
