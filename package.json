{
  "name": "cpi",
  "version": "0.1.1",
  "license": "MIT",
  "description": "The cpi CLI, extensions, skills, and supporting tools for the Pi fork.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "prepare:fork": "node scripts/fork.mjs",
    "install:dev": "bun install --frozen-lockfile --ignore-scripts && node scripts/fork.mjs && bun link --ignore-scripts --cwd packages/cli",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "ghostmux:build": "cd packages/ghostmux && zig build --release=safe",
    "ghostmux:test-install": "node packages/ghostmux/install.test.mjs",
    "test:cli": "cd packages/cli && node ../../node_modules/vitest/dist/cli.js --run test/vcs.test.ts test/footer-project.test.ts",
    "pack:release": "node packages/cli/scripts/package.mjs",
    "verify:release": "node packages/cli/scripts/verify-installed.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "jiti": "2.7.0",
    "mustache": "4.2.0",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "@bobcao3/cpi-tree-sitter-wasm": "0.0.1",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/d95f4bbf1e3be8a6a0de741261c2010b73dd2bc12d69bc2e9398d6e37a1341c7.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/ac52f3d8cd9fc4c58bd3b06dcfb3d5d6aa192fbd76d73b6ba5c9a046562f67e8.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/d7c80e5307742601e9037b3317e5a4fbc3d95a50149d27c713ce66d590a5ebfd.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/750ff13368dbe9572b69bb4ed4cb3740abe884fbe98ab1ab500fe58518af7e5b.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/6f4b73b69ed73674c8b0cc1b1d84801c4376f0960bb9c6458f6c5fa8dc8f6c96.tgz"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/d95f4bbf1e3be8a6a0de741261c2010b73dd2bc12d69bc2e9398d6e37a1341c7.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/ac52f3d8cd9fc4c58bd3b06dcfb3d5d6aa192fbd76d73b6ba5c9a046562f67e8.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/d7c80e5307742601e9037b3317e5a4fbc3d95a50149d27c713ce66d590a5ebfd.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/750ff13368dbe9572b69bb4ed4cb3740abe884fbe98ab1ab500fe58518af7e5b.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/6f4b73b69ed73674c8b0cc1b1d84801c4376f0960bb9c6458f6c5fa8dc8f6c96.tgz"
  },
  "devDependencies": {
    "@cpi/cli": "0.0.2",
    "@cpi/extensions": "0.0.2",
    "@cpi/ghostmux": "0.0.2",
    "@cpi/tree-sitter-wasm": "0.0.2",
    "@types/bun": "1.4.2",
    "@types/mustache": "4.2.6",
    "@types/node": "22.19.19",
    "diff": "8.0.4",
    "es-module-lexer": "2.3.1",
    "esbuild": "0.28.2",
    "prettier": "3.8.4",
    "tar": "7.5.22",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/extensions",
    "packages/ghostmux",
    "packages/tree-sitter-wasm"
  ],
  "bin": {
    "cpi": "packages/cli/bin/cpi"
  },
  "files": [
    "packages/cli",
    "packages/extensions",
    "packages/ghostmux",
    "packages/tree-sitter-wasm",
    "!**/node_modules",
    "!**/.zig-cache",
    "!**/zig-out",
    "!**/zig-pkg",
    "!**/.cache",
    "!**/dist",
    "!**/assets",
    "!**/native.json",
    "!**/*.tgz",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@cpi/ghostmux-linux-x64": "npm:@bobcao3/cpi-ghostmux-linux-x64@0.0.1",
    "@cpi/ghostmux-linux-arm64": "npm:@bobcao3/cpi-ghostmux-linux-arm64@0.0.1",
    "@cpi/ghostmux-darwin-x64": "npm:@bobcao3/cpi-ghostmux-darwin-x64@0.0.1",
    "@cpi/ghostmux-darwin-arm64": "npm:@bobcao3/cpi-ghostmux-darwin-arm64@0.0.1",
    "@cpi/ghostmux-win32-x64": "npm:@bobcao3/cpi-ghostmux-win32-x64@0.0.1"
  }
}
