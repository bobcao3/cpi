    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/cpi-1.4.0-1/99a7e7bc9ec440da2481260bddb8bbc43f820215bd78d53d61d2462ecbeeb581.tgz"
  },
  "devDependencies": {
    "@cpi/cli": "0.0.6",
    "@cpi/harness": "0.0.6",
    "@cpi/ghostmux": "0.0.6",
    "@cpi/prose": "0.0.6",
    "@cpi/tree-sitter-wasm": "0.0.6",
    "@types/bun": "1.4.2",
    "@types/mustache": "4.2.6",
    "@types/node": "22.19.19",
    "diff": "8.0.4",
    "es-module-lexer": "2.3.1",
    "esbuild": "0.28.2",
    "prettier": "3.8.4",
    "tar": "7.5.22",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/harness",
    "packages/ghostmux",
    "packages/prose",
    "packages/tree-sitter-wasm"
  ],
  "bin": {
    "cpi": "packages/cli/bin/cpi",
    "cpi-prose": "packages/prose/bin/cpi-prose.mjs"
  },
  "files": [
    "packages/cli",
    "packages/harness",
    "packages/ghostmux",
    "packages/prose",
    "packages/tree-sitter-wasm",
    "!**/node_modules",
    "!**/.zig-cache",
    "!**/zig-out",
    "!**/zig-pkg",
    "!**/.cache",
    "!**/.venv",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/.ruff_cache",
    "!**/dist",
    "!**/assets",
    "!**/native.json",
    "!**/*.tgz",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@cpi/ghostmux-linux-x64": "npm:@bobcao3/cpi-ghostmux-linux-x64@0.0.1",
    "@cpi/ghostmux-linux-arm64": "npm:@bobcao3/cpi-ghostmux-linux-arm64@0.0.1",
    "@cpi/ghostmux-darwin-x64": "npm:@bobcao3/cpi-ghostmux-darwin-x64@0.0.1",
    "@cpi/ghostmux-darwin-arm64": "npm:@bobcao3/cpi-ghostmux-darwin-arm64@0.0.1",
    "@cpi/ghostmux-win32-x64": "npm:@bobcao3/cpi-ghostmux-win32-x64@0.0.1"
  }
