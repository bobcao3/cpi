{
  "name": "cpi",
  "version": "0.1.1",
  "license": "MIT",
  "description": "The cpi CLI, extensions, skills, and supporting tools for the Pi fork.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "prepare:fork": "node scripts/fork.mjs",
    "install:dev": "bun install --frozen-lockfile --ignore-scripts && node scripts/fork.mjs && bun link --ignore-scripts --cwd packages/cli",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "ghostmux:build": "cd packages/ghostmux && zig build --release=safe",
    "ghostmux:test-install": "node packages/ghostmux/install.test.mjs",
    "test:cli": "cd packages/cli && node ../../node_modules/vitest/dist/cli.js --run test/vcs.test.ts test/footer-project.test.ts",
    "pack:release": "node packages/cli/scripts/package.mjs",
    "verify:release": "node packages/cli/scripts/verify-installed.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "jiti": "2.7.0",
    "mustache": "4.2.0",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "@bobcao3/cpi-tree-sitter-wasm": "0.0.1",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/4d2f9a62cbc3918bdf252daacc99bcdad03a16517b71b858b7fb1c9bb9da6734.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/ec7c0305d063872b790764997b325d0a000be87790253198d3a412934be6824d.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/5c8db36a8816809d4bec819730732c4244491069f2dd8dec968264e64b3ef34c.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/522710c990e1804661b076dd4db79f66060d5d54955eac73b6428153a9b3551d.tgz",
    "@earendil-works/pi-durable": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/5ed57d2e784520302bdaa299ba9e6514d0f4df1009d41635b9cb36bb4b296eb6.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/be5b38f136addad6021f6131b9889019a8592f7524419eb49c7899a041a850a8.tgz"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/4d2f9a62cbc3918bdf252daacc99bcdad03a16517b71b858b7fb1c9bb9da6734.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/ec7c0305d063872b790764997b325d0a000be87790253198d3a412934be6824d.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/5c8db36a8816809d4bec819730732c4244491069f2dd8dec968264e64b3ef34c.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/522710c990e1804661b076dd4db79f66060d5d54955eac73b6428153a9b3551d.tgz",
    "@earendil-works/pi-durable": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/5ed57d2e784520302bdaa299ba9e6514d0f4df1009d41635b9cb36bb4b296eb6.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-1/be5b38f136addad6021f6131b9889019a8592f7524419eb49c7899a041a850a8.tgz"
  },
  "devDependencies": {
    "@cpi/cli": "0.0.4",
    "@cpi/harness": "0.0.4",
    "@cpi/ghostmux": "0.0.4",
    "@cpi/tree-sitter-wasm": "0.0.4",
    "@types/bun": "1.4.2",
    "@types/mustache": "4.2.6",
    "@types/node": "22.19.19",
    "diff": "8.0.4",
    "es-module-lexer": "2.3.1",
    "esbuild": "0.28.2",
    "prettier": "3.8.4",
    "tar": "7.5.22",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/harness",
    "packages/ghostmux",
    "packages/tree-sitter-wasm"
  ],
  "bin": {
    "cpi": "packages/cli/bin/cpi"
  },
  "files": [
    "packages/cli",
    "packages/harness",
    "packages/ghostmux",
    "packages/tree-sitter-wasm",
    "!**/node_modules",
    "!**/.zig-cache",
    "!**/zig-out",
    "!**/zig-pkg",
    "!**/.cache",
    "!**/dist",
    "!**/assets",
    "!**/native.json",
    "!**/*.tgz",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@cpi/ghostmux-linux-x64": "npm:@bobcao3/cpi-ghostmux-linux-x64@0.0.1",
    "@cpi/ghostmux-linux-arm64": "npm:@bobcao3/cpi-ghostmux-linux-arm64@0.0.1",
    "@cpi/ghostmux-darwin-x64": "npm:@bobcao3/cpi-ghostmux-darwin-x64@0.0.1",
    "@cpi/ghostmux-darwin-arm64": "npm:@bobcao3/cpi-ghostmux-darwin-arm64@0.0.1",
    "@cpi/ghostmux-win32-x64": "npm:@bobcao3/cpi-ghostmux-win32-x64@0.0.1"
  }
}
