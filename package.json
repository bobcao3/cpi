{
  "name": "cpi",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The cpi CLI, extensions, skills, and supporting tools for the Pi fork.",
  "type": "module",
  "scripts": {
    "install:dev": "bun install --frozen-lockfile --ignore-scripts && bun link --ignore-scripts --cwd packages/cli",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "ghostmux:build": "cd packages/ghostmux && zig build --release=safe",
    "ghostmux:test-install": "node packages/ghostmux/install.test.mjs",
    "test:cli": "cd packages/cli && node ../../node_modules/vitest/dist/cli.js --run test/vcs.test.ts test/footer-project.test.ts",
    "pack:release": "node packages/cli/scripts/package.mjs",
    "verify:release": "node packages/cli/scripts/verify-installed.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "npm:@bobcao3/pi-agent-core@1.0.2-cpi.1",
    "@earendil-works/pi-ai": "npm:@bobcao3/pi-ai@1.0.2-cpi.1",
    "@earendil-works/chord": "npm:@bobcao3/pi-chord@1.0.2-cpi.1",
    "@earendil-works/pi-client": "npm:@bobcao3/pi-client@1.0.2-cpi.1",
    "@earendil-works/pi-codemode": "npm:@bobcao3/pi-codemode@1.0.2-cpi.1",
    "@earendil-works/pi-coding-agent": "npm:@bobcao3/pi-coding-agent@1.0.2-cpi.1",
    "@earendil-works/pi-durable": "npm:@bobcao3/pi-durable@1.0.2-cpi.1",
    "@earendil-works/pi-mcp": "npm:@bobcao3/pi-mcp@1.0.2-cpi.1",
    "@earendil-works/pi-protocol": "npm:@bobcao3/pi-protocol@1.0.2-cpi.1",
    "@earendil-works/pi-server": "npm:@bobcao3/pi-server@1.0.2-cpi.1",
    "@earendil-works/pi-telemetry": "npm:@bobcao3/pi-telemetry@1.0.2-cpi.1",
    "@earendil-works/pi-tui": "npm:@bobcao3/pi-tui@1.0.2-cpi.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "jiti": "2.7.0",
    "mustache": "4.2.0",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "@bobcao3/cpi-tree-sitter-wasm": "0.0.1"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "@earendil-works/pi-agent-core": "$@earendil-works/pi-agent-core",
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/chord": "$@earendil-works/chord",
    "@earendil-works/pi-client": "$@earendil-works/pi-client",
    "@earendil-works/pi-codemode": "$@earendil-works/pi-codemode",
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-durable": "$@earendil-works/pi-durable",
    "@earendil-works/pi-mcp": "$@earendil-works/pi-mcp",
    "@earendil-works/pi-protocol": "$@earendil-works/pi-protocol",
    "@earendil-works/pi-server": "$@earendil-works/pi-server",
    "@earendil-works/pi-telemetry": "$@earendil-works/pi-telemetry",
    "@earendil-works/pi-tui": "$@earendil-works/pi-tui"
  },
  "devDependencies": {
    "@cpi/cli": "0.0.1",
    "@cpi/extensions": "0.0.1",
    "@cpi/ghostmux": "0.0.1",
    "@cpi/tree-sitter-wasm": "0.0.1",
    "@types/bun": "1.4.2",
    "@types/mustache": "4.2.6",
    "@types/node": "22.19.19",
    "diff": "8.0.4",
    "es-module-lexer": "2.3.1",
    "esbuild": "0.28.2",
    "prettier": "3.8.4",
    "tar": "7.5.22",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/extensions",
    "packages/ghostmux",
    "packages/tree-sitter-wasm"
  ],
  "bin": {
    "cpi": "packages/cli/bin/cpi"
  },
  "files": [
    "packages/cli",
    "packages/extensions",
    "packages/ghostmux",
    "packages/tree-sitter-wasm",
    "!**/node_modules",
    "!**/.zig-cache",
    "!**/zig-out",
    "!**/zig-pkg",
    "!**/.cache",
    "!**/dist",
    "!**/assets",
    "!**/native.json",
    "!**/*.tgz",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@cpi/ghostmux-linux-x64": "npm:@bobcao3/cpi-ghostmux-linux-x64@0.0.1",
    "@cpi/ghostmux-linux-arm64": "npm:@bobcao3/cpi-ghostmux-linux-arm64@0.0.1",
    "@cpi/ghostmux-darwin-x64": "npm:@bobcao3/cpi-ghostmux-darwin-x64@0.0.1",
    "@cpi/ghostmux-darwin-arm64": "npm:@bobcao3/cpi-ghostmux-darwin-arm64@0.0.1",
    "@cpi/ghostmux-win32-x64": "npm:@bobcao3/cpi-ghostmux-win32-x64@0.0.1"
  }
}
