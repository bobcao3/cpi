{
  "name": "cpi",
  "version": "0.1.1",
  "license": "MIT",
  "description": "The cpi CLI, extensions, skills, and supporting tools for the Pi fork.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "prepare:fork": "node scripts/fork.mjs",
    "install:dev": "bun install --frozen-lockfile --ignore-scripts && node scripts/fork.mjs && bun link --ignore-scripts --cwd packages/cli",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "ghostmux:build": "cd packages/ghostmux && zig build --release=safe",
    "ghostmux:test-install": "node packages/ghostmux/install.test.mjs",
    "test:cli": "cd packages/cli && node ../../node_modules/vitest/dist/cli.js --run test/vcs.test.ts test/footer-project.test.ts",
    "pack:release": "node packages/cli/scripts/package.mjs",
    "verify:release": "node packages/cli/scripts/verify-installed.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "jiti": "2.7.0",
    "mustache": "4.2.0",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "@bobcao3/cpi-tree-sitter-wasm": "0.0.1",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/35da98196435fb23b8d4a4911002514aed3f7f95d43d830cde87444a2aa63210.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/91c65119604d95801c0acb0bd80017793a34e29a183b7bb07ab857cf5901868d.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/f81ad9935161039c522ba128e4be7abc50f1a53937870c2592fbe62c7adbd32d.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/544436aa6a7e74ab0716695c1cb0141d9d7e06c6d208000fb6ee7d4257fb464f.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/7e5428e1aada4e3dc9898be28cad0657a17ae65006bd59d24b11b7eb2759919a.tgz"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/35da98196435fb23b8d4a4911002514aed3f7f95d43d830cde87444a2aa63210.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/91c65119604d95801c0acb0bd80017793a34e29a183b7bb07ab857cf5901868d.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/f81ad9935161039c522ba128e4be7abc50f1a53937870c2592fbe62c7adbd32d.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/544436aa6a7e74ab0716695c1cb0141d9d7e06c6d208000fb6ee7d4257fb464f.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37998908067/7e5428e1aada4e3dc9898be28cad0657a17ae65006bd59d24b11b7eb2759919a.tgz"
  },
  "devDependencies": {
    "@cpi/cli": "0.0.3",
    "@cpi/harness": "0.0.3",
    "@cpi/ghostmux": "0.0.3",
    "@cpi/tree-sitter-wasm": "0.0.3",
    "@types/bun": "1.4.2",
    "@types/mustache": "4.2.6",
    "@types/node": "22.19.19",
    "diff": "8.0.4",
    "es-module-lexer": "2.3.1",
    "esbuild": "0.28.2",
    "prettier": "3.8.4",
    "tar": "7.5.22",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/harness",
    "packages/ghostmux",
    "packages/tree-sitter-wasm"
  ],
  "bin": {
    "cpi": "packages/cli/bin/cpi"
  },
  "files": [
    "packages/cli",
    "packages/harness",
    "packages/ghostmux",
    "packages/tree-sitter-wasm",
    "!**/node_modules",
    "!**/.zig-cache",
    "!**/zig-out",
    "!**/zig-pkg",
    "!**/.cache",
    "!**/dist",
    "!**/assets",
    "!**/native.json",
    "!**/*.tgz",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@cpi/ghostmux-linux-x64": "npm:@bobcao3/cpi-ghostmux-linux-x64@0.0.1",
    "@cpi/ghostmux-linux-arm64": "npm:@bobcao3/cpi-ghostmux-linux-arm64@0.0.1",
    "@cpi/ghostmux-darwin-x64": "npm:@bobcao3/cpi-ghostmux-darwin-x64@0.0.1",
    "@cpi/ghostmux-darwin-arm64": "npm:@bobcao3/cpi-ghostmux-darwin-arm64@0.0.1",
    "@cpi/ghostmux-win32-x64": "npm:@bobcao3/cpi-ghostmux-win32-x64@0.0.1"
  }
}
