{
  "name": "cpi",
  "version": "0.1.0",
  "description": "Cheng Cao's shared extensions and skills for the pi coding agent.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "lint": "node scripts/comment-scan.mjs extensions scripts tools",
    "format": "bun scripts/format.mjs --write",
    "format:check": "bun scripts/format.mjs --check"
  },
  "files": [
    "bin",
    "extensions",
    "skills",
    "cpi-config.default.json",
    "fallback-providers.example.json"
  ],
  "workspaces": [
    "tools/sh-monitor"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "cpi": ".",
    "mustache": "^4.2.0",
    "smol-toml": "^1.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@earendil-works/pi-tui": ">=0.83.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/mustache": "^4.2.6",
    "diff": "8.0.4",
    "prettier": "^3",
    "typescript": "~5.9"
  }
}
