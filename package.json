    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/cpi-1.4.0-1/e23e84600a10c9dd0fb057f6ddea6899db9f2bc0359305099d935c5423c7e9d3.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/cpi-1.4.0-1/6bcfc28efcf7b9daab02d754e4bb644b2cdcb7e70fccf7b8c9449663ede8db48.tgz",
