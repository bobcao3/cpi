{
  "name": "cpi",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Cheng Cao's shared extensions and skills for the pi coding agent.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "lint": "node scripts/comment-scan.mjs extensions scripts tools",
    "typecheck": "tsc --noEmit",
    "format": "bun scripts/format.mjs --write",
    "format:check": "bun scripts/format.mjs --check",
    "ghostmux:build": "cd tools/ghostmux && zig build --release=safe",
    "ghostmux:test-install": "node scripts/ghostmux-install.test.mjs"
  },
  "files": [
    "bin",
    "extensions",
    "skills",
    "tools/ghostmux/build.zig",
    "tools/ghostmux/build.zig.zon",
    "tools/ghostmux/src/*.{zig,c,h}",
    "tools/ghostmux/fonts/*.{zig,ttf,otf,txt,md,sha256,sh}",
    "tools/ghostmux/THIRD_PARTY_NOTICES.md",
    "cpi-config.default.json",
    "fallback-providers.example.json"
  ],
  "bin": {
    "subagent": "bin/subagent.js",
    "ghostmux": "bin/ghostmux.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "mustache": "^4.2.0",
    "sharp": "^0.35.4",
    "smol-toml": "^1.6.1"
  },
  "overrides": {
    "@types/node": "$@types/node"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/bun": "^1.4.2",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.0.0",
    "diff": "8.0.4",
    "prettier": "^3",
    "typebox": "^1.1.0",
    "typescript": "~5.9"
  }
}
