#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
RUNTIME_KIND=${CPI_RUNTIME_KIND:-node}
RUNTIME_BIN=${CPI_RUNTIME_BIN:-"$RUNTIME_KIND"}
ENTRY="$SCRIPT_DIR/probe.mts"
if [ ! -f "$ENTRY" ]; then
  ENTRY="$SCRIPT_DIR/probe.mjs"
fi

case "$RUNTIME_KIND" in
  bun)
    exec "$RUNTIME_BIN" "$ENTRY" "$@"
    ;;
  deno)
    exec "$RUNTIME_BIN" run -A "$ENTRY" "$@"
    ;;
  node)
    exec "$RUNTIME_BIN" --disable-warning=ExperimentalWarning "$ENTRY" "$@"
    ;;
  *)
    echo "unsupported CPI_RUNTIME_KIND: $RUNTIME_KIND" >&2
    exit 1
    ;;
esac
