{
  "name": "@cpi/cli",
  "version": "0.0.2",
  "private": true,
  "description": "cpi coding agent and SDK",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "bin": {
    "cpi": "./bin/cpi"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./bootstrap": {
      "types": "./bootstrap.d.mts",
      "import": "./bootstrap.mjs"
    },
    "./package.json": "./package.json",
    "./cli": "./src/cli.ts"
  },
  "piConfig": {
    "name": "cpi",
    "configDir": ".cpi",
    "selfUpdate": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@cpi/extensions": "0.0.2",
    "jiti": "2.7.0",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/d95f4bbf1e3be8a6a0de741261c2010b73dd2bc12d69bc2e9398d6e37a1341c7.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/ac52f3d8cd9fc4c58bd3b06dcfb3d5d6aa192fbd76d73b6ba5c9a046562f67e8.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/d7c80e5307742601e9037b3317e5a4fbc3d95a50149d27c713ce66d590a5ebfd.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/750ff13368dbe9572b69bb4ed4cb3740abe884fbe98ab1ab500fe58518af7e5b.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/pi-1.1.1-cpi.37871095732/6f4b73b69ed73674c8b0cc1b1d84801c4376f0960bb9c6458f6c5fa8dc8f6c96.tgz"
  },
  "scripts": {
    "check": "node scripts/check-boundaries.mjs",
    "pack:release": "node scripts/package.mjs",
    "verify:release": "node scripts/verify-installed.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "bootstrap.mjs",
    "source.mjs",
    "bootstrap.d.mts",
    "LICENSE",
    "README.md"
  ]
}
