{
  "name": "@cpi/cli",
  "version": "0.0.4",
  "private": true,
  "description": "cpi coding agent and SDK",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "bin": {
    "cpi": "./bin/cpi"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./bootstrap": {
      "types": "./bootstrap.d.mts",
      "import": "./bootstrap.mjs"
    },
    "./package.json": "./package.json",
    "./cli": "./src/cli.ts"
  },
  "piConfig": {
    "name": "cpi",
    "configDir": ".cpi",
    "selfUpdate": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@cpi/harness": "0.0.4",
    "jiti": "2.7.0",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-3/be311c06d53d775f7de671ce8c20af9fad3db37d5de1ea0251bc1e7bd94748b8.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-3/4a70b535305820bcfd25eef15b51abd00ff4b24bbd835d5dd7b649437fa8f6e1.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-3/86043194db75eeafbda891bdcdf5d437ac38fba2c6ab980a2a80fd0426c25450.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-3/24a7e102d989aab87b87eb5af2d0fc0b59f489543e224b7893fe999c53020c72.tgz",
    "@earendil-works/pi-durable": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-3/cfeef7d0628ccb0479bef4e48039a8ad350cae35355c837b095ec2eb7872307a.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/cpi-1.2.0-3/e163721b112d4f18bc384e9b2243180a0642d11aefc4b50870cdd754daa60652.tgz"
  },
  "scripts": {
    "check": "node scripts/check-boundaries.mjs",
    "pack:release": "node scripts/package.mjs",
    "verify:release": "node scripts/verify-installed.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "bootstrap.mjs",
    "source.mjs",
    "bootstrap.d.mts",
    "LICENSE",
    "README.md"
  ]
}
