{
  "name": "@cpi/cli",
  "version": "0.0.4",
  "private": true,
  "description": "cpi coding agent and SDK",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "bin": {
    "cpi": "./bin/cpi"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./bootstrap": {
      "types": "./bootstrap.d.mts",
      "import": "./bootstrap.mjs"
    },
    "./package.json": "./package.json",
    "./cli": "./src/cli.ts"
  },
  "piConfig": {
    "name": "cpi",
    "configDir": ".cpi",
    "selfUpdate": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@cpi/harness": "0.0.4",
    "jiti": "2.7.0",
    "@earendil-works/pi-agent-core": "https://github.com/bobcao3/pi/releases/download/cpi-1.3.0-1/b8c07d6d9a98da2d0b54f0ab42ae370b4e63ad534fc0ef1aee3511c3e532e9f1.tgz",
    "@earendil-works/pi-ai": "https://github.com/bobcao3/pi/releases/download/cpi-1.3.0-1/e67a03ab00e168129f12487eb2d57ebfc328112aeef8f07538229984457a2e4c.tgz",
    "@earendil-works/pi-codemode": "https://github.com/bobcao3/pi/releases/download/cpi-1.3.0-1/38f1f919f9d2173a939bf0b77793840264eb759ca689dafb700b74fc06046e29.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/bobcao3/pi/releases/download/cpi-1.3.0-1/92be5d0132fff71a502bb3691c1fddf8632fa488a6fea827ca7e5d81663dd8e3.tgz",
    "@earendil-works/pi-durable": "https://github.com/bobcao3/pi/releases/download/cpi-1.3.0-1/470abe5fb7442ce00916a23a7cc70ca64bf6c21508dd7b804119d4bb8ee605ff.tgz",
    "@earendil-works/pi-tui": "https://github.com/bobcao3/pi/releases/download/cpi-1.3.0-1/b12003bda3772d413dfaf2ecd2b2a087dab43b0fd3f6d5195a2fb1cd8698c8b9.tgz"
  },
  "scripts": {
    "check": "node scripts/check-boundaries.mjs",
    "pack:release": "node scripts/package.mjs",
    "verify:release": "node scripts/verify-installed.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "bootstrap.mjs",
    "source.mjs",
    "bootstrap.d.mts",
    "LICENSE",
    "README.md"
  ]
}
