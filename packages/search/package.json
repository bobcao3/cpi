{
  "name": "@cpi/search",
  "version": "0.0.6",
  "private": true,
  "description": "Codemode web search and page retrieval with Codex, Exa, and SearXNG failover",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "search.default.json",
    "README.md",
    "LICENSE",
    "!src/*.test.ts"
  ],
  "dependencies": {
    "@cpi/harness": "0.0.6",
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
