#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
RUNTIME_KIND=${CPI_RUNTIME_KIND:-node}
RUNTIME_BIN=${CPI_RUNTIME_BIN:-"$RUNTIME_KIND"}

case "$RUNTIME_KIND" in
  bun)
    exec "$RUNTIME_BIN" "$SCRIPT_DIR/probe.mts" "$@"
    ;;
  deno)
    exec "$RUNTIME_BIN" run -A "$SCRIPT_DIR/probe.mts" "$@"
    ;;
  node)
    exec "$RUNTIME_BIN" --disable-warning=ExperimentalWarning "$SCRIPT_DIR/probe.mts" "$@"
    ;;
  *)
    echo "unsupported CPI_RUNTIME_KIND: $RUNTIME_KIND" >&2
    exit 1
    ;;
esac
