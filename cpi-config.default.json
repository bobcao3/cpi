{
  "shell": {
    "executable": "auto",
    "defaultWaitfor": 5,
    "maxWaitfor": 30,
    "maxPreviewLines": 500,
    "previewMaxBytes": 32768,
    "maxAcc": 4194304,
    "updateMs": 200,
    "tailLines": 5,
    "describeMax": 48
  },
  "fast": {
    "providers": ["openai", "openai-codex"],
    "models": ["gpt-6-luna", "gpt-6-sol", "gpt-6-astra"]
  },
  "forkProbe": {
    "substitutions": [
      { "from": "gpt-5.6-sol", "to": "gpt-6-luna:medium" },
      { "from": "gpt-6-sol", "to": "gpt-6-luna:medium" },
      { "from": "gpt-6-astra", "to": "gpt-6-luna:medium" },
      { "from": "claude-opus-5", "to": "claude-sonnet-5:medium" },
      { "from": "claude-fable-5", "to": "claude-sonnet-5:medium" },
      { "from": "claude-fable-5-1", "to": "claude-sonnet-5:medium" }
    ]
  },
  "editor": {
    "mode": "direct-diff",
    "maxFileBytes": 262144,
    "subagentTimeoutMs": 120000,
    "maxCorrectionTurns": 2,
    "maxTranscripts": 200,
    "fuzzyMatch": true,
    "chain": [
      {
        "search": "(claude-)(fable|opus)[0-9.-]*:xhigh",
        "replace": "$1sonnet-5:medium"
      },
      {
        "search": "(claude-)(fable|opus)[0-9.-]*",
        "replace": "$1sonnet-5:low"
      },
      {
        "search": "gpt-[^:/]*-(terra|sol|astra)[^:]*:[^:]*",
        "replace": "gpt-6-luna:medium"
      },
      { "search": "gpt-[^:]*:[^:]*", "replace": "gpt-6-luna:medium" },
      {
        "search": "gemini-[^:]*:(high|xhigh|max)",
        "replace": "gemini-3.5-flash-lite:high"
      },
      {
        "search": "gemini-[^:]*:[^:]*",
        "replace": "gemini-3.5-flash-lite:low"
      },
      { "search": "grok-[^:]*", "replace": "grok-build-0.1" },
      {
        "search": "^(.+[Dd]eep[Ss]eek[^:]*):[^:]*$",
        "replace": "$1:low"
      },
      {
        "search": "^(.+[Gg][Ll][Mm][^:]*):[^:]*$",
        "replace": "$1:low"
      },
      { "search": "^(.+):(high|xhigh|max)$", "replace": "$1:medium" }
    ]
  },
  "lsp": {
    "startupTimeoutMs": 30000,
    "lintTimeoutMs": 10000,
    "installTimeoutMs": 60000,
    "discoveryMaxDepth": 32,
    "servers": {
      "typescript": {
        "package": "typescript-language-server",
        "version": "5.3.0",
        "tsVersion": "6.0.3"
      },
      "python": { "package": "pyrefly", "version": "1.0.0" },
      "shell": { "enabled": true }
    },
    "tools": {
      "uv": {
        "version": "0.11.23",
        "repo": "astral-sh/uv",
        "verify": "attestation-then-sha256"
      }
    }
  }
}
