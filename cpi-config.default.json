{
  "shell": {
    "executable": "auto",
    "defaultWaitfor": 5,
    "maxWaitfor": 30,
    "maxPreviewLines": 500,
    "previewMaxBytes": 32768,
    "maxAcc": 4194304,
    "updateMs": 200,
    "tailLines": 5,
    "describeMax": 48
  },
  "fast": {
    "providers": ["openai", "openai-codex"],
    "models": [
      "gpt-5.4",
      "gpt-5.5",
      "gpt-5.6",
      "gpt-5.6-sol",
      "gpt-5.6-terra",
      "gpt-5.6-luna"
    ]
  },
  "editor": {
    "mode": "direct-diff",
    "maxFileBytes": 262144,
    "subagentTimeoutMs": 120000,
    "maxCorrectionTurns": 2,
    "maxTranscripts": 200,
    "fuzzyMatch": true,
    "chain": [
      {
        "search": "(claude-)(fable|opus)[0-9.-]*:xhigh",
        "replace": "$1sonnet-5:medium"
      },
      {
        "search": "(claude-)(fable|opus)[0-9.-]*",
        "replace": "$1sonnet-5:low"
      },
      {
        "search": "gpt-5\\.6-(sol|terra)[^:]*:[^:]*",
        "replace": "gpt-5.6-terra:low"
      },
      {
        "search": "gpt-5\\.6-luna[^:]*:[^:]*",
        "replace": "gpt-5.6-luna:medium"
      },
      { "search": "gpt-(?:5|4o)[^:]*:[^:]*", "replace": "gpt-5.6-luna:medium" },
      { "search": "gemini-[^:]*:xhigh", "replace": "gemma-4-31b-it:high" },
      { "search": "gemini-[^:]*", "replace": "gemma-4-31b-it" },
      {
        "search": "gemini-[^:]*:xhigh",
        "replace": "gemini-3.1-flash-lite:high"
      },
      { "search": "gemini-[^:]*", "replace": "gemini-3.1-flash-lite" },
      { "search": "grok-3[^:]*:xhigh", "replace": "grok-4.3:high" },
      { "search": "grok-3[^:]*", "replace": "grok-4.3" },
      { "search": "(deepseek-v[0-9]*-)pro:xhigh", "replace": "$1flash:high" },
      { "search": "(deepseek-v[0-9]*-)pro(?=:|$)", "replace": "$1flash" },
      { "search": "^(.+):xhigh$", "replace": "$1:medium" }
    ]
  },
  "lsp": {
    "startupTimeoutMs": 30000,
    "lintTimeoutMs": 10000,
    "installTimeoutMs": 60000,
    "discoveryMaxDepth": 32,
    "servers": {
      "typescript": {
        "package": "typescript-language-server",
        "version": "5.3.0",
        "tsVersion": "6.0.3"
      },
      "python": { "package": "pyrefly", "version": "1.0.0" },
      "shell": { "enabled": true }
    },
    "tools": {
      "uv": {
        "version": "0.11.23",
        "repo": "astral-sh/uv",
        "verify": "attestation-then-sha256"
      }
    }
  }
}
