#!/usr/bin/env bash
# env-capture — snapshot the current shell env into a session-scoped dotenv.
# See ../skills/env-capture/SKILL.md for workflow and reload details.
#
# WHY: Chain this at the END of the same command so the captured env reflects
# whatever the preceding command did. The script inherits that exact env.
#
# Contents are written to a file and are NEVER echoed into the conversation.
set -euo pipefail

label=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--label) label="${2:-}"; shift 2 ;;
    -h|--help)  printf 'usage: env-capture [-l label] [label]\n'; exit 0 ;;
    *)          label="$1"; shift ;;
  esac
done

if [[ -n "${PI_SESSION_DIR:-}" ]]; then
  dir="$PI_SESSION_DIR/env-captures"
else
  dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/env-captures"
fi
mkdir -p "$dir"

if [[ -n "$label" ]]; then
  name="$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-64).env"
else
  name="env-$(date +%s)-$$.env"
fi
file="$dir/$name"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

env | awk '
  {
    eq = index($0, "=")
    if (eq <= 1) next
    key = substr($0, 1, eq - 1)
    if (key !~ /^[A-Za-z_][A-Za-z0-9_]*$/) next
    val = substr($0, eq + 1)
    if (length(val) > 32768) val = substr(val, 1, 32768)
    print key "=" val
    if (++n >= 4096) exit
  }
' > "$tmp"

count=$(wc -l < "$tmp" | tr -d ' ')
if [[ "$count" -eq 0 ]]; then
  printf 'env-capture: no KEY=VALUE lines captured\n' >&2
  exit 1
fi

mv "$tmp" "$file"

plural=""
(( count != 1 )) && plural="s"
printf 'Captured %d env var%s → %s\nReload via: env=%s\n' \
  "$count" "$plural" "$file" "$file"
